<UserControl x:Class="CodexForVS.Extension.CodexChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel LastChildFill="False">
      <TextBlock FontSize="16" FontWeight="SemiBold" Text="Codex Chat" />
      <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2" Command="{Binding ConnectCommand}" Content="Connect" />
      <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2" Command="{Binding NewConversationCommand}" Content="New Conversation" />
      <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2" Command="{Binding SignInCommand}" Content="Sign In" />
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="0,8,0,8">
      <WrapPanel Margin="0,0,0,4">
        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
          <TextBlock Text="Mode" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox AutomationProperties.Name="Conversation mode" ItemsSource="{Binding Modes}"
                    SelectedItem="{Binding Mode, Mode=TwoWay}" IsEnabled="{Binding CanChangeMode}"
                    ToolTip="Plan a change or refine an existing plan in this conversation. Both modes are read-only." />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
        <TextBlock Text="Approval policy" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox AutomationProperties.Name="Approval policy" ItemsSource="{Binding ApprovalPolicies}"
                  SelectedItem="{Binding ApprovalPolicy, Mode=TwoWay}" IsEnabled="{Binding CanChangePolicy}"
                  ToolTip="never runs sandbox-permitted commands. untrusted also blocks commands that need confirmation. Changing policy starts a fresh thread on your next send." />
        </StackPanel>
      </WrapPanel>
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Activity}" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Activity}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock FontSize="11" Text="{Binding WorkspaceName}" />
      <TextBlock FontSize="11" Text="{Binding WorkspacePath}" TextTrimming="CharacterEllipsis" />
      <TextBlock FontWeight="SemiBold" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="2" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" CornerRadius="3">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnHistoryScrollChanged">
      <ItemsControl ItemsSource="{Binding Messages}" HorizontalContentAlignment="Stretch"
                    Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="MessageBorder" Margin="5" Padding="7" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" CornerRadius="3">
              <StackPanel>
                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Role}" />
                <TextBox Margin="0,3,0,0" Padding="0" BorderThickness="0" Background="Transparent"
                         Foreground="{Binding Path=(TextElement.Foreground), ElementName=MessageBorder}"
                         IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" AcceptsReturn="True"
                         HorizontalScrollBarVisibility="Disabled" ToolTip="Select text and press Ctrl+C to copy"
                         Text="{Binding Content, Mode=OneWay}" />
              </StackPanel>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Role}" Value="user">
                <Setter TargetName="MessageBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
                <Setter TargetName="MessageBorder" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>
    </Border>
    <TextBox Grid.Row="3" Margin="0,8,0,4" MinHeight="58" AcceptsReturn="True" PreviewKeyDown="OnInputKeyDown" ToolTip="Enter to send, Shift+Enter for a new line" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
    <DockPanel Grid.Row="4" LastChildFill="False">
      <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="12,3" Command="{Binding CancelTurnCommand}" Content="Cancel" />
      <Button DockPanel.Dock="Right" Padding="12,3" Command="{Binding SendMessageCommand}" Content="Send" />
    </DockPanel>
    <StackPanel Grid.Row="5" Margin="0,4,0,0" DataContext="{Binding Usage}">
      <WrapPanel>
        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Read-only mode" />
        <ToggleButton x:Name="UsageToggle" Padding="6,2" ToolTip="Show or hide Codex usage"
                      AutomationProperties.Name="{Binding Summary}">
          <WrapPanel>
            <TextBlock Text="{Binding Summary}" />
            <TextBlock Margin="4,0,0,0" Text="▾" />
          </WrapPanel>
        </ToggleButton>
      </WrapPanel>
      <Border Margin="0,4,0,0" Padding="8" BorderThickness="1"
              BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsChecked, ElementName=UsageToggle}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Codex usage" />
          <ItemsControl ItemsSource="{Binding Windows}" Focusable="False"
                        Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <WrapPanel Margin="0,4,0,0">
                  <TextBlock Text="{Binding Description}" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding ResetText}" />
                </WrapPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <DockPanel Margin="0,6,0,0">
            <Button Content="Refresh" DockPanel.Dock="Right" Padding="6,2" Command="{Binding RefreshCommand}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Status}" />
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
