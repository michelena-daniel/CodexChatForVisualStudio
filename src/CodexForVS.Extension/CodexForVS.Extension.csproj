<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <RegisterWithCodebase>true</RegisterWithCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <VsixDeployOnDebug Condition="'$(BuildingInsideVisualStudio)' == 'true'">true</VsixDeployOnDebug>
    <DeployExtension Condition="'$(MSBuildRuntimeType)' == 'Core'">false</DeployExtension>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3">
      <ForceIncludeInVSIX>true</ForceIncludeInVSIX>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodexForVS.Client\CodexForVS.Client.csproj" />
    <ProjectReference Include="..\CodexForVS.Core\CodexForVS.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <VSCTCompile Include="CodexForVS.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <SourceVsixManifest Include="source.extension.vsixmanifest" />
  </ItemGroup>
  <!-- VSSDK 17.14 can reuse a previous detokenized manifest across version bumps. -->
  <Target Name="InvalidateStaleVsixManifest" BeforeTargets="DetokenizeVsixManifestFile"
          Inputs="@(SourceVsixManifest)" Outputs="$(IntermediateVsixManifest)">
    <Delete Files="$(IntermediateVsixManifest)" Condition="Exists('$(IntermediateVsixManifest)')" />
  </Target>
</Project>
